# Development points at the Vite dev-server proxy (see vite.config.js), so API
# and socket traffic is same-origin and never trips the backend's CORS rules.
# These are RELATIVE paths — Vite's proxy rewrites them to http://localhost:5000.
VITE_API_URL=/api/v1
VITE_SOCKET_URL=http://localhost:5000

# Fallback geofence used when a company has none configured.
VITE_OFFICE_LATITUDE=4.1025
VITE_OFFICE_LONGITUDE=9.3908
VITE_VERIFICATION_RADIUS=20
